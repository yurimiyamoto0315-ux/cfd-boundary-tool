            <value>@If(@Strncmp($COEFF,0,1),開口なし,全開口)</value>
          </data>
          <data type="string">
            <name>散乱係数指定（0～1）</name>
            <nameappendix></nameappendix>
            <cntag>SSCATTERING</cntag>
            <value>0</value>
          </data>
        </category>
        <category>
          <name>最適化条件</name>
          <cntag>OPTIMIZE</cntag>
          <data type="string">
            <name>開口率</name>
            <nameappendix>@Strcat(\(,@OptPanelValue(%LABEL,9),\ [%],\))</nameappendix>
            <cntag>RCND</cntag>
            <value>変更しない</value>
          </data>
          <data type="float">
            <name>開口率最小値</name>
            <nameappendix></nameappendix>
            <cntag>RMIN</cntag>
            <value>0.000000e+00</value>
          </data>
          <data type="float">
            <name>開口率最大値</name>
            <nameappendix></nameappendix>
            <cntag>RMAX</cntag>
            <value>1.000000e+02</value>
          </data>
        </category>
      </property>
    </model>
  </model>
