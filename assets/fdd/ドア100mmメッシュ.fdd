    <surface type="poly">3,2,1</surface>
    <surface type="poly">1,2,3</surface>
    <surface type="poly">3,1,0</surface>
    <surface type="poly">0,1,3</surface>
    <showwire>True</showwire>
    <fixedsize>False</fixedsize>
    <layer>0</layer>
    <ignoremodelcheck>False</ignoremodelcheck>
    <fillobstacle>0</fillobstacle>
    <panelneighborcheck>0</panelneighborcheck>
    <edgemesh>0</edgemesh>
    <showsurfacetemp>True</showsurfacetemp>
    <vicinitymesh>0.000000</vicinitymesh>
    <recognizetype>0</recognizetype>
    <property>
      <objecttype>形状モデル</objecttype>
      <objectid>HEATOBJ</objectid>
      <pluginname>AmPropHeatObjPlug</pluginname>
      <edgemesh>false</edgemesh>
      <edgemeshflag>0</edgemeshflag>
      <cache index="0">false,0.000000e+00,0.000000e+00,0,65536,0.000000e+00</cache>
      <cache index="1">false,0.000000e+00,0.000000e+00,0,0,0.000000e+00</cache>
      <cache index="2">false,0.000000e+00,0.000000e+00,0,0,0.000000e+00</cache>
      <cache index="3">false,0.000000e+00,0.000000e+00,0,0,0.000000e+00</cache>
      <cache index="4">false,0.000000e+00,0.000000e+00,0,0,0.000000e+00</cache>
      <cache index="5">false,0.000000e+00,0.000000e+00,0,0,0.000000e+00</cache>
      <cache index="6">false,0.000000e+00,0.000000e+00,0,0,0.000000e+00</cache>
      <cache index="7">false,0.000000e+00,0.000000e+00,0,0,0.000000e+00</cache>
      <cache index="8">false,0.000000e+00,0.000000e+00,0,0,0.000000e+00</cache>
      <cache index="9">false,0.000000e+00,0.000000e+00,0,0,0.000000e+00</cache>
      <category>
        <name>一般条件</name>
        <cntag>GENERAL</cntag>
        <data type="string">
          <name>属性</name>
          <cntag>ATTRIBUTE</cntag>
          <value>厚みを考慮</value>
        </data>
        <data type="string">
          <name>種類</name>
          <cntag>FLDPRP</cntag>
          <value></value>
        </data>
        <data type="string">
          <name>適用方法</name>
          <cntag>FLDAPL</cntag>
          <value>くりぬき</value>
        </data>
        <data type="string">
          <name>面熱境界条件設定</name>
          <cntag>SHETOBJ</cntag>
          <value>設定しない</value>
        </data>
        <data type="string">
          <name>@Strcat(表面温度\ [,#TEMPERATUREUNIT,])</name>
          <cntag>STEMP</cntag>
          <value>#STEMP</value>
        </data>
        <data type="string">
          <name>材質</name>
          <cntag>MATPRP</cntag>
          <value>2杉(1)</value>
        </data>
        <data type="string">
          <name>合成材質</name>
          <cntag>CMATPRP</cntag>
          <value></value>
        </data>
        <data type="float">
          <name>@Strcat(疑似厚み\ [,#LENGTHUNIT,])</name>
          <cntag>THICKNESS</cntag>
          <value>3.000000e-02</value>
        </data>
        <data type="float">
          <name>@Strcat(内部発熱量\ [,#HEATBYVOLUMEUNIT,])</name>
          <cntag>HEATBYVOLUME</cntag>
          <value>0.000000e+00</value>
        </data>
        <data type="float">
          <name>@Strcat(熱伝達率＋\ [,#HEATTRANSUNIT,])</name>
          <cntag>TRANSPLUS</cntag>
          <value>0.000000e+00</value>
        </data>
        <data type="float">
          <name>@Strcat(熱伝達率－\ [,#HEATTRANSUNIT,])</name>
          <cntag>TRANSMINUS</cntag>
          <value>0.000000e+00</value>
        </data>
        <data type="float">
          <name>@Strcat(発熱量\ [,#HEATUNIT,])</name>
          <cntag>HEATVALUE</cntag>
          <value>0.000000e+00</value>
        </data>
        <data type="float">
