    <matrix type="rotate">1.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,1.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,1.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,1.000000e+00</matrix>
    <vertex id="0">0.000000e+00,0.000000e+00,2.452000e+00</vertex>
    <vertex id="1">8.280000e-01,0.000000e+00,2.452000e+00</vertex>
    <vertex id="2">8.280000e-01,0.000000e+00,0.000000e+00</vertex>
